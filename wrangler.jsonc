{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "draft-watcher",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "DRAFT_WATCHER_PUBLIC_BASE_URL": "https://draft-watcher.aaguil3.workers.dev"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REGISTRY",
        "class_name": "Registry"
      },
      {
        "name": "DRAFT_WATCHER",
        "class_name": "DraftWatcher"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Registry", "DraftWatcher"]
    }
  ]
}
